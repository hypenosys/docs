# General
DOMAIN=localhost
TIMEZONE=Europe/Madrid

# PostgreSQL
POSTGRES_USER=hypenosys
POSTGRES_PASSWORD=hypeno-pass-change-me
POSTGRES_DB=hypenosys_vault

# Forgejo
FORGEJO_DB_TYPE=postgres
FORGEJO_DB_HOST=postgresql:5432
FORGEJO_DB_NAME=forgejo
FORGEJO_DB_USER=forgejo
FORGEJO_DB_PASS=forgejo-pass

# Matrix (Synapse)
SYNAPSE_SERVER_NAME=matrix.localhost
SYNAPSE_REPORT_STATS=no
SYNAPSE_DB_USER=synapse
SYNAPSE_DB_PASSWORD=synapse-pass

# n8n
N8N_BLOCK_PYTHON_CAN_ACCESS_MAIN_PROCESS=false
N8N_ENCRYPTION_KEY=super-secret-n8n-key
N8N_USER_MANAGEMENT_JWT_SECRET=another-secret

# Ollama
OLLAMA_KEEP_ALIVE=24h
